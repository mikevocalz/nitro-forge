{
  "name": "nitro-forge",
  "private": true,
  "version": "0.0.0",
  "description": "Nitro-Forge: native document engines for React Native, built on Nitro Modules + Rust.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:rust": "cargo test --locked --workspace",
    "test:completion-backends": "cargo test --locked -p photo-engine -p motion-engine -p design-engine -p draft-engine && cargo build --locked -p nf-cli && vitest run --config tooling/completion-backends.vitest.config.mjs",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "verify:nyc-tron": "node tooling/verify-nyc-tron-pin.mjs",
    "test:lab-config": "node --test tooling/lab-metro-config.test.cjs",
    "verify:timeline-source": "node tooling/verify-timeline-source.mjs",
    "verify:canvas-source": "node tooling/verify-canvas-source.mjs",
    "verify:audio-source": "node tooling/verify-audio-source.mjs",
    "verify:workspace-source": "node tooling/verify-workspace-source.mjs",
    "verify:released-ui": "node tooling/verify-released-ui.mjs",
    "verify:completion": "node tooling/verify-completion-plan.mjs",
    "test:completion": "node --test tooling/verify-completion-plan.test.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.3.0"
  }
}
