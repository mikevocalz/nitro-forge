{
  "name": "nitro-forge",
  "private": true,
  "version": "0.0.0",
  "description": "Nitro-Forge: native document engines for React Native, built on Nitro Modules + Rust.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:rust": "cargo test --workspace",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "build:packages": "pnpm --filter \"./packages/**\" -r run build",
    "pack:packages": "node tooling/packages/pack.mjs",
    "check:packages": "pnpm run build:packages && pnpm run pack:packages && node tooling/packages/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  }
}
