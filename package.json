{
  "name": "nitro-forge",
  "private": true,
  "version": "0.0.0",
  "description": "Nitro-Forge: native document engines for React Native, built on Nitro Modules + Rust.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:rust": "cargo test --workspace --manifest-path rust/Cargo.toml",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "verify:nyc-tron": "node tooling/verify-nyc-tron-pin.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.3.0"
  }
}
