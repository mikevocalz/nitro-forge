diff --git a/packages/react-native-video/Package.swift b/packages/react-native-video/Package.swift
new file mode 100644
--- /dev/null
+++ b/packages/react-native-video/Package.swift
@@ -0,0 +1,55 @@
+// swift-tools-version: 6.4
+
+import PackageDescription
+
+// React Native's SwiftPM integration links this package below
+// ios/build/generated/autolinking/libs/ReactNativeVideo. Framework and codegen
+// paths below are relative to that generated location, not the npm checkout.
+let reactHeaders: [Target.Dependency] = [
+  .product(name: "ReactHeaders", package: "ReactNative"),
+  .product(name: "ReactNativeHeaders", package: "ReactNative"),
+  .product(name: "ReactNativeDependenciesHeaders", package: "ReactNative"),
+]
+let package = Package(
+  name: "ReactNativeVideo",
+  platforms: [.iOS(.v16)],
+  dependencies: [
+    .package(name: "React-GeneratedCode", path: "../../../ios"),
+  ],
+  cxxLanguageStandard: .cxx20
+)
+
+addNitrogenTargets(
+  to: package,
+  swiftSources: [
+    "ios/core", "ios/hybrids",
+    "ios/view/VideoComponentView.swift",
+    "ios/view/VideoComponentViewObserver.swift",
+  ],
+  cxxSources: [],
+  dependencies: [.product(name: "ReactHeaders", package: "ReactNative")]
+)
+
+// Keep ObjC++ Fabric view sources out of the Swift target. This experimental
+// port requires RN 0.88's New Architecture; the legacy Paper view is not built.
+package.targets.append(.target(
+  name: "ReactNativeVideoFabric",
+  dependencies: [
+    "ReactNativeVideo", "ReactNativeVideoSwiftBridge",
+    .product(name: "ReactAppHeaders", package: "React-GeneratedCode"),
+  ] + reactHeaders,
+  path: "ios/view/fabric",
+  sources: ["RCTVideoViewComponentView.mm", "RCTVideoViewViewManager.mm"],
+  publicHeadersPath: ".",
+  cxxSettings: [
+    .define("RCT_NEW_ARCH_ENABLED", to: "1"),
+    .define("DEBUG", .when(configuration: .debug)),
+    .define("NDEBUG", .when(configuration: .release)),
+    .unsafeFlags(["-I${GENERATED_MODULEMAP_DIR}", "-fno-modules"]),
+  ]
+))
+package.products.removeAll { $0.name == "ReactNativeVideo" }
+package.products.append(.library(
+  name: "ReactNativeVideo",
+  targets: ["ReactNativeVideoCxx", "ReactNativeVideo", "ReactNativeVideoSwiftBridge", "ReactNativeVideoFabric"]
+))
