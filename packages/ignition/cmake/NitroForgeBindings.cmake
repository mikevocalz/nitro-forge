include_guard(GLOBAL)

# Compile against the host's one Nitro core. A target advertises the version of
# the headers/library it owns with its NITRO_CORE_VERSION property. The package
# neither installs another core nor accepts an unversioned native ABI.
function(nitroforge_add_nitro_bindings)
  cmake_parse_arguments(FORGE "" "NITRO_TARGET" "" ${ARGN})
  if(FORGE_UNPARSED_ARGUMENTS OR NOT FORGE_NITRO_TARGET OR
     NOT TARGET "${FORGE_NITRO_TARGET}")
    message(FATAL_ERROR "nitroforge_add_nitro_bindings requires NITRO_TARGET naming the host's Nitro core target")
  endif()
  if(TARGET nitroforge_nitro)
    get_target_property(previous_core nitroforge_nitro NITRO_FORGE_CORE_TARGET)
    if(NOT previous_core STREQUAL FORGE_NITRO_TARGET)
      message(FATAL_ERROR "Ignition cannot bind two different Nitro cores in one process")
    endif()
    return()
  endif()
  get_target_property(core_version "${FORGE_NITRO_TARGET}" NITRO_CORE_VERSION)
  get_target_property(compatibility_profile "${FORGE_NITRO_TARGET}" NITRO_SOURCE_COMPATIBILITY_PROFILE)
  set(qt_source_compatible FALSE)
  if(core_version STREQUAL "1.0.0-alpha.nightly.105.g69d365fc9b18" AND
     compatibility_profile STREQUAL "rnqnx-qt-alpha105")
    set(qt_source_compatible TRUE)
  endif()
  if(NOT core_version STREQUAL "1.0.0-alpha.nightly.120.g33ef045b96c0" AND NOT qt_source_compatible)
    message(FATAL_ERROR
      "Ignition generated bindings require Nitro core 1.0.0-alpha.nightly.120.g33ef045b96c0; "
      "${FORGE_NITRO_TARGET} advertises '${core_version}'. "
      "The only older source profile is alpha105 with the rnqnx-qt-alpha105 dispatcher. "
      "Use NitroForge::RustSession without Nitro, or a reviewed matching host runtime.")
  endif()

  get_filename_component(ignition_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  # These generated C++ class descriptions are identical for Apple and Android.
  # They contain no Apple SDK code. Reuse them, without platform installers/JNI,
  # so portable hosts receive the exact constructor and methods generated by Nitro.
  set(classes ForgeDocument ForgeFactory ForgeMediaCache ForgeTask)
  set(sources
    "${ignition_root}/cpp/HybridForgeFactory.cpp"
    "${ignition_root}/cpp/HybridForgeDocument.cpp"
    "${ignition_root}/cpp/NitroForgeRegistration.cpp"
    "${ignition_root}/nitrogen/generated/apple/NitroForgeV1Autolinking.cpp")
  foreach(class IN LISTS classes)
    list(APPEND sources
      "${ignition_root}/nitrogen/generated/apple/c++/Hybrid${class}SpecClass.cpp"
      "${ignition_root}/nitrogen/generated/shared/c++/Hybrid${class}Spec.cpp")
  endforeach()
  foreach(value ForgeBinaryCommandResult ForgeCommand ForgeCommandResult ForgeEvent)
    list(APPEND sources "${ignition_root}/nitrogen/generated/shared/c++/${value}.cpp")
  endforeach()
  add_library(nitroforge_nitro STATIC ${sources})
  add_library(NitroForge::Nitro ALIAS nitroforge_nitro)
  set_target_properties(nitroforge_nitro PROPERTIES
    POSITION_INDEPENDENT_CODE ON NITRO_FORGE_CORE_TARGET "${FORGE_NITRO_TARGET}")
  target_compile_features(nitroforge_nitro PUBLIC cxx_std_20)
  target_include_directories(nitroforge_nitro PUBLIC
    "${ignition_root}/cpp"
    "${ignition_root}/nitrogen/generated/shared/c++/include"
    PRIVATE "${ignition_root}/nitrogen/generated/apple/c++/include")
  target_link_libraries(nitroforge_nitro PUBLIC
    NitroForge::RustSession NitroForge::SerialQueue "${FORGE_NITRO_TARGET}")
endfunction()
