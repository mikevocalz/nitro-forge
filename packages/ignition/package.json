{
  "name": "@nitro-forge/ignition",
  "version": "0.1.0",
  "description": "Nitro-Forge native integration layer: engine session contracts, Nitro HybridObject spec, and host transports.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/host-cli.ts",
    "./nitro": "./src/specs/ForgeFactory.nitro.ts",
    "./v1-host": "./src/v1-host.ts",
    "./workspace": "./src/workspace.ts",
    "./transfer": "./src/transfer.ts",
    "./workspace-ui": "./src/workspace-ui.ts",
    "./transfer-ui": "./src/transfer-ui.ts",
    "./autosave": "./src/autosave.ts",
    "./transactions": "./src/transactions.ts",
    "./collaboration": "./src/collaboration.ts",
    "./collaboration-http": "./src/collaboration-http.ts",
    "./collaboration-checkpoint": "./src/collaboration-checkpoint.ts",
    "./app.plugin.cjs": {
      "types": "./app.plugin.d.cts",
      "default": "./app.plugin.cjs"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "codegen": "nitrogen"
  },
  "devDependencies": {
    "react-native-nitro-modules": "1.0.0-alpha.nightly.136.gdb81de61bd32",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "nitrogen": "1.0.0-alpha.nightly.136.gdb81de61bd32",
    "nitro-core": "1.0.0-alpha.nightly.136.gdb81de61bd32"
  },
  "imports": {
    "#nitro/*": "./nitrogen/generated/shared/javascript/*.cjs"
  },
  "peerDependencies": {
    "react-native-nitro-modules": "1.0.0-alpha.nightly.136.gdb81de61bd32",
    "nitro-core": "1.0.0-alpha.nightly.136.gdb81de61bd32"
  },
  "swiftpmConfig": {
    "name": "NitroForgeV1",
    "dependencies": [
      "react-native-nitro-modules"
    ]
  },
  "files": [
    "src",
    "react-native.config.cjs",
    "Package.swift",
    "NitroForgeV1.podspec",
    "nitro.json",
    "cpp",
    "nitrogen/generated",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "android/src",
    "native",
    "app.plugin.cjs",
    "plugin/withForge.cjs",
    "app.plugin.d.cts",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "license": "MIT"
}
