{
  "name": "@nitro-forge/ignition",
  "version": "0.1.0",
  "description": "Nitro-Forge native integration layer: engine session contracts, Nitro HybridObject spec, and host transports.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./cli": "./src/host-cli.ts",
    "./nitro": "./src/Forge.nitro.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "react-native-nitro-modules": "^0.29.8",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "nitro.json"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "react-native": "./dist/index.js",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json",
      "./cli": {
        "types": "./dist/host-cli.d.ts",
        "node": {
          "import": "./dist/host-cli.js"
        },
        "default": null
      },
      "./nitro": {
        "types": "./dist/Forge.nitro.d.ts",
        "default": "./src/Forge.nitro.ts"
      }
    }
  },
  "peerDependencies": {
    "react-native-nitro-modules": "^0.29.8"
  },
  "peerDependenciesMeta": {
    "react-native-nitro-modules": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikevocalz/nitro-forge.git",
    "directory": "packages/ignition"
  },
  "bugs": {
    "url": "https://github.com/mikevocalz/nitro-forge/issues"
  }
}
