{
  "name": "@nitro-forge/ignition",
  "version": "0.1.0",
  "description": "Nitro-Forge native integration layer: engine session contracts, Nitro HybridObject spec, and host transports.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./native": "./CMakeLists.txt",
    "./cli": "./src/host-cli.ts",
    "./nitro": {
      "types": "./src/specs/ForgeFactory.nitro.ts",
      "qnx": "./portable/ForgeFactory.cjs",
      "marathon": "./portable/ForgeFactory.cjs",
      "default": "./src/specs/ForgeFactory.nitro.ts"
    },
    "./v1-host": "./src/v1-host.ts",
    "./workspace": "./src/workspace.ts",
    "./transfer": "./src/transfer.ts",
    "./workspace-ui": "./src/workspace-ui.ts",
    "./transfer-ui": "./src/transfer-ui.ts",
    "./autosave": "./src/autosave.ts",
    "./autosave/mmkv": "./src/autosave-mmkv.ts",
    "./transactions": "./src/transactions.ts",
    "./collaboration": "./src/collaboration.ts",
    "./collaboration-http": "./src/collaboration-http.ts",
    "./collaboration-checkpoint": "./src/collaboration-checkpoint.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "codegen": "nitrogen"
  },
  "devDependencies": {
    "react-native-nitro-modules": "1.0.0-alpha.nightly.120.g33ef045b96c0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "nitrogen": "1.0.0-alpha.nightly.120.g33ef045b96c0",
    "nitro-core": "1.0.0-alpha.nightly.120.g33ef045b96c0"
  },
  "imports": {
    "#nitro/*": "./nitrogen/generated/shared/javascript/*.cjs",
    "#forge-factory": {
      "types": "./nitrogen/generated/shared/javascript/ForgeFactory.d.cts",
      "qnx": "./portable/ForgeFactory.cjs",
      "marathon": "./portable/ForgeFactory.cjs",
      "default": "./nitrogen/generated/shared/javascript/ForgeFactory.cjs"
    }
  },
  "rnqnxNative": {
    "schemaVersion": 1,
    "platforms": {
      "qnx": {
        "cmakeListsPath": "qt/CMakeLists.txt",
        "target": "nitroforge_nitro",
        "registrationHeader": "NitroForgeV1/NitroForgeRegistration.hpp",
        "registrationFunction": "nitroforge::native::registerNitroForgeClasses",
        "nitroCoreVersions": ["1.0.0-alpha.nightly.105.g69d365fc9b18"],
        "requiresDispatcher": true
      },
      "marathon": {
        "cmakeListsPath": "qt/CMakeLists.txt",
        "target": "nitroforge_nitro",
        "registrationHeader": "NitroForgeV1/NitroForgeRegistration.hpp",
        "registrationFunction": "nitroforge::native::registerNitroForgeClasses",
        "nitroCoreVersions": ["1.0.0-alpha.nightly.105.g69d365fc9b18"],
        "requiresDispatcher": true
      }
    }
  },
  "peerDependencies": {
    "react-native-nitro-modules": "1.0.0-alpha.nightly.105.g69d365fc9b18 || 1.0.0-alpha.nightly.120.g33ef045b96c0",
    "nitro-core": "1.0.0-alpha.nightly.105.g69d365fc9b18 || 1.0.0-alpha.nightly.120.g33ef045b96c0"
  },
  "peerDependenciesMeta": {
    "react-native-nitro-modules": {
      "optional": true
    }
  },
  "swiftpmConfig": {
    "name": "NitroForgeV1",
    "dependencies": [
      "react-native-nitro-modules"
    ]
  }
}
