{
  "name": "@nitro-forge/prism",
  "version": "0.1.0",
  "description": "Nitro-Forge prism document API.",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "react-native": "./lib/index.js",
  "exports": {
    ".": {
      "@nitro-forge/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "react-native": "./lib/index.js",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./canvas-cluster": {
      "@nitro-forge/source": "./src/canvas-cluster.ts",
      "types": "./lib/canvas-cluster.d.ts",
      "react-native": "./lib/canvas-cluster.js",
      "import": "./lib/canvas-cluster.js",
      "default": "./lib/canvas-cluster.js"
    },
    "./color-cluster": {
      "@nitro-forge/source": "./src/color-cluster.ts",
      "types": "./lib/color-cluster.d.ts",
      "react-native": "./lib/color-cluster.js",
      "import": "./lib/color-cluster.js",
      "default": "./lib/color-cluster.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nitro-forge/ignition": "workspace:*"
  },
  "devDependencies": {
    "@nitro-forge/editor-controls": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
