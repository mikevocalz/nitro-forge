{
  "name": "@nitro-forge/media-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Forge media controls: re-exports NYC-Tron UI's seek bar, waveform lane, level fader and timebase math",
  "license": "UNLICENSED",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./math": {
      "types": "./src/timebase.ts",
      "default": "./src/timebase.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests"
  },
  "dependencies": {
    "@nyc-tron/ui": "https://github.com/mikevocalz/NYC-Tron-UI/releases/download/v0.1.0-alpha.4/nyc-tron-ui-0.1.0-alpha.4.tgz"
  },
  "peerDependencies": {
    "@expo/ui": "^58.0.0",
    "expo": "^58.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.88.0"
  },
  "devDependencies": {
    "vitest": "^3.2.7",
    "@types/react": "^19.2.0"
  }
}
