{
  "name": "@nitro-forge/media-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Forge media controls: re-exports NYC-Tron UI's seek bar, waveform lane, level fader and timebase math",
  "license": "UNLICENSED",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./math": {
      "types": "./src/timebase.ts",
      "default": "./src/timebase.ts"
    },
    "./video": {
      "types": "./src/video/index.ts",
      "default": "./src/video/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests"
  },
  "dependencies": {
    "@nyc-tron/ui": "https://github.com/mikevocalz/NYC-Tron-UI/releases/download/v1.0.0-rc.2/nyc-tron-ui-1.0.0-rc.2.tgz",
    "@nyc-tron/platform-services": "https://github.com/mikevocalz/NYC-Tron-UI/releases/download/v1.0.0-rc.2/nyc-tron-platform-services-1.0.0-rc.2.tgz"
  },
  "peerDependencies": {
    "@expo/ui": "^58.0.0",
    "expo": "^58.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.88.0",
    "zustand": "^5.0.16",
    "react-native-video": "7.0.0-beta.12-nitrov1-experimental.1"
  },
  "devDependencies": {
    "vitest": "^5.1.0",
    "@types/react": "^19.3.0",
    "react-native-video": "file:../../tooling/react-native-video-v1/experimental-build-v1.tgz"
  },
  "peerDependenciesMeta": {
    "react-native-video": {
      "optional": true
    }
  }
}
