{
  "name": "@nitro-forge/media-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform native transport, frame seek bar and waveform primitives for Nitro Forge Studio",
  "license": "UNLICENSED",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
