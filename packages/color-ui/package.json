{
  "name": "@nitro-forge/color-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Universal native RGBA color controls for Nitro Forge editors on Expo SDK 58",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./color": {
      "types": "./src/color.ts",
      "default": "./src/color.ts"
    },
    "./field": {
      "types": "./src/fieldGeometry.ts",
      "default": "./src/fieldGeometry.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests"
  },
  "peerDependencies": {
    "@expo/ui": "^58.0.0",
    "expo": "^58.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.88.0",
    "expo-linear-gradient": "^58.0.0"
  },
  "devDependencies": {
    "vitest": "^3.2.7",
    "@types/react": "^19.2.0"
  }
}
