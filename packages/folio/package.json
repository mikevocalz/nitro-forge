{
  "name": "@nitro-forge/folio",
  "version": "0.1.0",
  "description": "Nitro-Forge folio document API.",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "react-native": "./lib/index.js",
  "exports": {
    ".": {
      "@nitro-forge/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "react-native": "./lib/index.js",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./office-cluster": {
      "@nitro-forge/source": "./src/office-cluster.ts",
      "types": "./lib/office-cluster.d.ts",
      "react-native": "./lib/office-cluster.js",
      "import": "./lib/office-cluster.js",
      "default": "./lib/office-cluster.js"
    },
    "./render": {
      "@nitro-forge/source": {
        "node": "./src/render.ts",
        "types": "./src/render.ts"
      },
      "types": "./lib/render.d.ts",
      "node": "./lib/render.js"
    },
    "./transfer": {
      "@nitro-forge/source": "./src/transfer.ts",
      "types": "./lib/transfer.d.ts",
      "react-native": "./lib/transfer.js",
      "import": "./lib/transfer.js",
      "default": "./lib/transfer.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@nitro-forge/ignition": "workspace:*"
  },
  "devDependencies": {
    "@nitro-forge/ignition": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "@nyc-tron/ui": "https://github.com/mikevocalz/NYC-Tron-UI/releases/download/v1.0.0-rc.2/nyc-tron-ui-1.0.0-rc.2.tgz",
    "@nitro-forge/editor-controls": "workspace:*"
  }
}
