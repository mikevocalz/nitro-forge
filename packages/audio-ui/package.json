{
  "name": "@nitro-forge/audio-ui",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Real microphone recording and metering UI on Expo SDK 58, connected to Forge waveform controls.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./recording": {
      "types": "./src/recording.ts",
      "default": "./src/recording.ts"
    },
    "./pcm": {
      "types": "./src/NativeSourceRecordingTrack.tsx",
      "browser": "./src/NativeSourceRecordingTrack.web.tsx",
      "react-native": "./src/NativeSourceRecordingTrack.native.tsx",
      "default": "./src/NativeSourceRecordingTrack.tsx"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests"
  },
  "dependencies": {
    "@nitro-forge/media-ui": "workspace:*",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "@expo/ui": "^58.0.0",
    "expo": "^58.0.0",
    "expo-audio": "^58.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.88.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "vitest": "^3.2.7"
  }
}
