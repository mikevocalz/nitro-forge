  },
  "peerDependencies": {
    "@expo/ui": "^58.0.0",
    "expo": "^58.0.0",
    "expo-audio": "^58.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.88.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "vitest": "^3.2.7"
  }
