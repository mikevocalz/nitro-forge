{
  "name": "@nitro-forge/audio-ui",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Audio API native PCM recording and shared graph playback, with browser MediaRecorder capture.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./recording": {
      "types": "./src/recording.ts",
      "default": "./src/recording.ts"
    },
    "./pcm": {
      "types": "./src/NativeSourceRecordingTrack.tsx",
      "react-native": "./src/NativeSourceRecordingTrack.native.tsx",
      "browser": "./src/NativeSourceRecordingTrack.web.tsx",
      "default": "./src/NativeSourceRecordingTrack.unsupported.ts"
    },
    "./playback": {
      "types": "./src/NativeAudioPreview.tsx",
      "default": "./src/NativeAudioPreview.tsx"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --dir tests"
  },
  "dependencies": {
    "@nitro-forge/media-ui": "workspace:*",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "@expo/ui": "^58.0.0",
    "expo": "^58.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.88.0",
    "react-native-audio-api": "1.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "vitest": "^3.2.7"
  }
}
