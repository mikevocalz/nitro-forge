{
  "name": "@nitro-forge/ignition-v1-lab",
  "version": "0.0.0-v1-lab",
  "private": true,
  "description": "Isolated Nitro v1 code-generation probe for the existing Ignition Rust engines. Not installed in any app.",
  "type": "module",
  "imports": {
    "#nitro/*": "./nitrogen/generated/shared/javascript/*.cjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./specs/*": "./src/specs/*.nitro.ts"
  },
  "scripts": {
    "codegen": "nitrogen",
    "typecheck": "nitrogen && tsc --noEmit -p tsconfig.json",
    "check:generated": "node ../../tooling/nitro-v1/verify-generated.mjs"
  },
  "peerDependencies": {
    "react-native-nitro-modules": "1.0.0-alpha.nightly.120.g33ef045b96c0",
    "nitro-core": "1.0.0-alpha.nightly.120.g33ef045b96c0"
  },
  "devDependencies": {
    "nitrogen": "1.0.0-alpha.nightly.120.g33ef045b96c0",
    "nitro-core": "1.0.0-alpha.nightly.120.g33ef045b96c0",
    "typescript": "^6.0.3"
  },
  "swiftpmConfig": {
    "name": "NitroForgeV1",
    "dependencies": [
      "react-native-nitro-modules"
    ]
  }
}
