{
  "name": "@nitro-forge/motion",
  "version": "0.1.0",
  "description": "Bounded persistent 2D motion with Prism frame rendering.",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "react-native": "./lib/index.js",
  "exports": {
    ".": {
      "@nitro-forge/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "react-native": "./lib/index.js",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --config ../../tooling/completion-backends.vitest.config.mjs packages/motion/tests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@nitro-forge/ignition": "workspace:*"
  },
  "devDependencies": {
    "@nitro-forge/ignition": "workspace:*",
    "typescript": "7.0.2"
  }
}
