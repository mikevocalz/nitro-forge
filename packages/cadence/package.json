{
  "name": "@nitro-forge/cadence",
  "version": "0.1.0",
  "description": "Nitro-Forge cadence document API.",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "react-native": "./lib/index.js",
  "exports": {
    ".": {
      "@nitro-forge/source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "react-native": "./lib/index.js",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./instrument-adapter": {
      "@nitro-forge/source": "./src/instrument-adapter.ts",
      "types": "./lib/instrument-adapter.d.ts",
      "react-native": "./lib/instrument-adapter.js",
      "import": "./lib/instrument-adapter.js",
      "default": "./lib/instrument-adapter.js"
    },
    "./instrument-session": {
      "@nitro-forge/source": "./src/instrument-session.ts",
      "types": "./lib/instrument-session.d.ts",
      "react-native": "./lib/instrument-session.js",
      "import": "./lib/instrument-session.js",
      "default": "./lib/instrument-session.js"
    },
    "./editor-adapter": {
      "@nitro-forge/source": "./src/editor-adapter.ts",
      "types": "./lib/editor-adapter.d.ts",
      "react-native": "./lib/editor-adapter.js",
      "import": "./lib/editor-adapter.js",
      "default": "./lib/editor-adapter.js"
    },
    "./mixer-cluster": {
      "@nitro-forge/source": "./src/mixer-cluster.ts",
      "types": "./lib/mixer-cluster.d.ts",
      "react-native": "./lib/mixer-cluster.js",
      "import": "./lib/mixer-cluster.js",
      "default": "./lib/mixer-cluster.js"
    },
    "./transfer": {
      "@nitro-forge/source": "./src/transfer.ts",
      "types": "./lib/transfer.d.ts",
      "react-native": "./lib/transfer.js",
      "import": "./lib/transfer.js",
      "default": "./lib/transfer.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@nitro-forge/ignition": "workspace:*"
  },
  "devDependencies": {
    "@nitro-forge/ignition": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "@nyc-tron/ui": "https://github.com/mikevocalz/NYC-Tron-UI/releases/download/v1.0.0-rc.2/nyc-tron-ui-1.0.0-rc.2.tgz",
    "@types/react": "~19.3.0",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "@nitro-forge/editor-controls": "workspace:*"
  }
}
