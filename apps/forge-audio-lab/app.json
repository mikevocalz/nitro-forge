{
  "expo": {
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "../../tooling/brand/plugin.cjs",
        {
          "manifest": "./brand.json"
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Allow Nitro Forge to record audio for your project.",
          "iosBackgroundMode": false,
          "androidPermissions": [
            "android.permission.RECORD_AUDIO"
          ],
          "androidForegroundService": false,
          "enableFFmpeg": false
        }
      ]
    ]
  }
}
