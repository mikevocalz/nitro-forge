{
  "name": "@nitro-forge/studio-preview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:bridge": "node verify-bridge.mjs",
    "test:integration": "node verify-local.mjs",
    "test:ui-modules": "node verify-ui-modules.mjs",
    "test": "node --test src/*.test.ts",
    "test:engine": "vitest run tests",
    "test:render": "node verify-render.mjs dev",
    "test:render:build": "node verify-render.mjs preview"
  },
  "dependencies": {
    "expo-linear-gradient": "58.0.4",
    "@nitro-forge/studio-workspace": "workspace:*",
    "@nitro-forge/studio-layout": "workspace:*",
    "@nitro-forge/ignition": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native-web": "0.21.4",
    "zustand": "5.1.0",
    "@nitro-forge/icons": "workspace:*",
    "react-native-svg": "15.16.1",
    "@nyc-tron/ui": "https://github.com/mikevocalz/NYC-Tron-UI/releases/download/v1.0.0-rc.2/nyc-tron-ui-1.0.0-rc.2.tgz",
    "@nyc-tron/expo-controls": "https://github.com/mikevocalz/NYC-Tron-UI/releases/download/v1.0.0-rc.2/nyc-tron-expo-controls-1.0.0-rc.2.tgz"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.65.1",
    "vite": "8.3.8",
    "typescript": "7.0.2",
    "tailwindcss": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "vitest": "5.1.0"
  }
}
